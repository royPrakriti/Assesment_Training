{\pntext\f4\'B7\tab}Object identification\par
{\pntext\f4\'B7\tab}Context understanding\par
{\pntext\f4\'B7\tab}Semantic meaning\par

\pard\widctlpar\sa160\sl276\slmult1\b Working\par
\b0 Input\par
